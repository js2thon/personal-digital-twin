# 本机 PostgreSQL（当前版本必需；数据库需预先创建）
DATABASE_URL=postgresql+psycopg://twin:change_me@127.0.0.1:5432/personal_twin

# 可选 Redis（异步任务场景）
REDIS_URL=redis://127.0.0.1:6379/0

# 可选 MinIO（未配置时使用内置存储降级）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# API / Web
API_PORT=8100
ALLOWED_ORIGINS=http://127.0.0.1:8100,http://localhost:8100
API_KEY=

# LLM 推理（OpenAI 兼容接口）
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=empty
LLM_MODEL=qwen

# Embedding
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# RAGFlow（可选，官方 HTTP API）
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=

# 企业 IM 消息接管：真实外发总开关
REPLY_SEND_ENABLED=false
REPLY_AI_TAG=true

# 运行与治理
APP_ENV=dev
SHACL_MODE=warn
