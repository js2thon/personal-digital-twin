# ===== PostgreSQL =====
POSTGRES_USER=twin
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_SECRET
POSTGRES_DB=personal_twin
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_PORT=6379

# ===== MinIO =====
MINIO_ROOT_USER=twinadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== API / Web =====
API_PORT=8100
WEB_PORT=8200

# ===== LLM 推理（OpenAI 兼容接口；本机实跑时配置为企业 OneAPI 网关）=====
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
VLLM_SERVED_MODEL=qwen
VLLM_PORT=8001
LLM_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=empty
LLM_MODEL=qwen

# ===== Embedding（BGE-M3，维度按实际模型调整）=====
EMBEDDING_BASE_URL=http://vllm:8000/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
HF_CACHE=~/.cache/huggingface

# ===== RAGFlow 1.0（官方 API 接入，固定 v1.0.0 版本）=====
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=

# ===== 企业 IM消息接管：真实外发总开关 =====
# 默认 false：只生成回复草稿并做 dry-run 预览，绝不向任何人发送消息。
# 设为 true 后，仍需在控制台对每条草稿逐条确认 + 二次弹窗确认才会外发。
REPLY_SEND_ENABLED=false

# ===== 访问控制（端口外露时必配）=====
# 本机回环(127.0.0.1)访问默认视为本人；非回环请求必须带 X-Twin-API-Key: <API_KEY>。
# 留空 = 拒绝一切非回环 API 访问（默认最安全）。
API_KEY=REPLACE_WITH_LONG_RANDOM_API_KEY
ALLOWED_ORIGINS=http://127.0.0.1:8101,http://localhost:8101
# 发送角标：true=带钉钉固定角标「通过AI发送」，false=不带角标（不支持自定义文案）
REPLY_AI_TAG=true
